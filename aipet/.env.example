# ---- Brain -------------------------------------------------------------
# Leave unset to run fully offline on the deterministic "instinct" brain.
ANTHROPIC_API_KEY=
AIPET_MODEL=claude-opus-5-5
AIPET_EFFORT=medium            # low | medium | high
AIPET_MAX_LLM_CALLS_PER_TICK=6

# ---- Identity / hosting -----------------------------------------------
AIPET_HOME=./pet_home          # where the pet keeps its memory, creations and site
AIPET_SITE_URL=                # public URL of the built site, e.g. https://you.github.io/hello-world/
AIPET_OWNER_EMAIL=             # the pet writes you letters here
AIPET_SEED=                    # fix for reproducible offline runs

# ---- The pet's own email account (IMAP + SMTP) ------------------------
# Leave blank to use the local file mailbox (aipet mail send ...).
AIPET_EMAIL_ADDRESS=
AIPET_IMAP_HOST=
AIPET_IMAP_PORT=993
AIPET_SMTP_HOST=
AIPET_SMTP_PORT=587
AIPET_EMAIL_USER=
AIPET_EMAIL_PASSWORD=
AIPET_EMAIL_ALLOWLIST=         # comma-separated addresses/domains the pet may write to unprompted
AIPET_MAX_EMAILS_PER_DAY=10

# ---- Shop --------------------------------------------------------------
AIPET_CURRENCY=usd
STRIPE_SECRET_KEY=             # optional: real checkout via Stripe Payment Links

# ---- Misc --------------------------------------------------------------
AIPET_RESEARCH_ENABLED=1       # lets the pet read random Wikipedia summaries
