+// HLK-LD2450 report frame (datasheet §2.2): AA FF 03 00 | 3 x 8-byte target | 55 CC.
+const LD2450_HEAD = [0xaa, 0xff, 0x03, 0x00];
+const LD2450_TAIL = [0x55, 0xcc];
+const LD2450_TARGETS = 3;
+const LD2450_BODY = LD2450_TARGETS * 8;
+
+/** LD2450 sign-magnitude int16: top bit set = positive, low 15 bits = magnitude. */
+export function ld2450Signed(lo, hi) {
+  const raw = lo | (hi << 8);
+  const mag = raw & 0x7fff;
+  return raw & 0x8000 ? mag : -mag;
+}
+
+/** Streaming HLK-LD2450 / Rd-03D report parser. feed() returns decoded frames. */
+export class Ld2450Parser {
+  constructor() { this.state = 0; this.errors = 0; this.data = []; }
+  feed(bytes) {
+    const frames = [];
+    for (const b of bytes) {
+      if (this.state < 4) {
+        this.state = b === LD2450_HEAD[this.state] ? this.state + 1 : (b === LD2450_HEAD[0] ? 1 : 0);
+        if (this.state === 4) this.data = [];
+      } else if (this.state === 4) {
+        this.data.push(b);
+        if (this.data.length >= LD2450_BODY) this.state = 5;
+      } else {
+        const i = this.state - 5;
+        if (b !== LD2450_TAIL[i]) { this.errors += 1; this.state = b === LD2450_HEAD[0] ? 1 : 0; continue; }
+        if (i === 1) { frames.push(decodeLd2450(this.data)); this.state = 0; } else this.state += 1;
+      }
+    }
+    return frames;
+  }
+}
+
+function decodeLd2450(d) {
+  const targets = [];
+  for (let t = 0; t < LD2450_TARGETS; t += 1) {
+    const o = t * 8;
+    // An empty slot is all zeros; a real target always has y > 0 (in front of the board).
+    if (d.slice(o, o + 8).every((v) => v === 0)) continue;
+    const xMm = ld2450Signed(d[o], d[o + 1]);
+    const yMm = ld2450Signed(d[o + 2], d[o + 3]);
+    const speedCmS = ld2450Signed(d[o + 4], d[o + 5]);
+    const resolutionMm = d[o + 6] | (d[o + 7] << 8);
+    targets.push({
+      slot: t, xMm, yMm, speedCmS, resolutionMm,
+      distanceCm: Number((Math.hypot(xMm, yMm) / 10).toFixed(1)),
+      angleDeg: Number(((Math.atan2(xMm, yMm) * 180) / Math.PI).toFixed(1)),
+    });
+  }
+  const nearest = targets.reduce((a, t) => (a === null || t.distanceCm < a ? t.distanceCm : a), null);
+  return { type: 'targets', present: targets.length > 0, targetCount: targets.length, targets, distanceCm: nearest ?? 0 };
+}
+
